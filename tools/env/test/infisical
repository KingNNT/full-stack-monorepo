#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq programs use $vars that must not expand in the shell
# Test double for the infisical CLI, backed by the JSON file $INFISICAL_STATE:
#   {"folders": {"<env>": ["/apps", "/apps/api"]},
#    "secrets": {"<env>": {"<path>": {"KEY": "value"}}}}
# Implements only the calls tools/env/lib.sh makes and logs argv to
# $INFISICAL_LOG. Calls need INFISICAL_TOKEN or, with FAKE_INFISICAL_SESSION=1,
# a host login session. FAKE_INFISICAL_FAIL=1 makes every call fail like
# rejected credentials.
set -euo pipefail
printf '%s\n' "$*" >>"$INFISICAL_LOG"
if [ "${FAKE_INFISICAL_FAIL:-0}" = 1 ]; then
  echo "error: unauthorized" >&2
  exit 1
fi

if [ "$*" = "login status --json --silent" ]; then
  if [ "${FAKE_INFISICAL_SESSION:-0}" = 1 ]; then
    echo '{"sessions": [{"principalType": "user", "status": "authenticated"}]}'
  else
    echo '{"sessions": []}'
    exit 1
  fi
  exit 0
fi
if [ "${1:-}" = login ]; then
  if [ "$*" != "login --method=universal-auth --plain --silent" ] \
    || [ -z "${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID:-}" ] || [ -z "${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET:-}" ]; then
    echo "fake infisical: unsupported login: $*" >&2
    exit 2
  fi
  echo "ua-token"
  exit 0
fi
if [ -n "${INFISICAL_TOKEN:-}" ]; then
  printf 'token=%s\n' "$INFISICAL_TOKEN" >>"$INFISICAL_LOG"
elif [ "${FAKE_INFISICAL_SESSION:-0}" = 1 ]; then
  echo "token=session" >>"$INFISICAL_LOG"
else
  echo "error: not logged in" >&2
  exit 1
fi

cmd="" env=dev path=/ name="" file="" expand=true project=""
while [ $# -gt 0 ]; do
  case "$1" in
    --env | --path | --name | --file | --format | --projectId | -o)
      opt="$1" val="$2"
      shift 2
      ;;
    --*=*)
      opt="${1%%=*}" val="${1#*=}"
      shift
      ;;
    -*)
      shift
      continue
      ;;
    *)
      cmd="$cmd $1"
      shift
      continue
      ;;
  esac
  case "$opt" in
    --env) env="$val" ;;
    --path) path="$val" ;;
    --name) name="$val" ;;
    --file) file="$val" ;;
    --expand) expand="$val" ;;
    --projectId) project="$val" ;;
  esac
done

if [ -z "$project" ]; then
  echo "error: --projectId is required with a machine identity token" >&2
  exit 1
fi

state() { jq -c "$@" "$INFISICAL_STATE"; }

save() {
  local tmp
  tmp="$(mktemp)"
  jq "$@" "$INFISICAL_STATE" >"$tmp"
  mv "$tmp" "$INFISICAL_STATE"
}

require_folder() {
  if [ "$path" != / ] \
    && ! state -e --arg e "$env" --arg p "$path" 'any((.folders[$e] // [])[]; . == $p)' >/dev/null; then
    echo "error: folder $path not found in $env" >&2
    exit 1
  fi
}

case "$cmd" in
  " secrets folders get")
    require_folder
    state --arg e "$env" --arg p "$path" '[(.folders[$e] // [])[]
      | select((sub("/[^/]+$"; "") | if . == "" then "/" else . end) == $p)
      | {name: sub(".*/"; "")}]'
    ;;
  " secrets folders create")
    require_folder
    save --arg e "$env" --arg f "${path%/}/$name" '.folders[$e] = (((.folders[$e] // []) + [$f]) | unique)'
    ;;
  " export")
    require_folder
    # With --expand, resolves ${<env>.shared.<KEY>} references, leaves an
    # unresolvable one as written, and — like the real CLI — treats any other
    # $NAME in a value as shell expansion of an unset variable.
    state --arg e "$env" --arg p "$path" --arg x "$expand" '. as $root
      | (.secrets[$e][$p] // {}) | to_entries | map({key, value})
      | if $x == "true" then
          map(.value |= (gsub("\\$(?<n>[A-Za-z_][A-Za-z0-9_]*)"; "")
            | gsub("\\$\\{(?<e>[^.}]+)\\.shared\\.(?<k>[^}]+)\\}";
                $root.secrets[.e]["/shared"][.k] // "${\(.e).shared.\(.k)}")))
        else . end'
    ;;
  " secrets set")
    require_folder
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      save --arg e "$env" --arg p "$path" --argjson k "${line%%\": *}\"" --argjson v "${line#*\": }" \
        '.secrets[$e][$p][$k] = $v'
    done <"$file"
    echo "secrets set (values masked)"
    ;;
  *)
    echo "fake infisical: unsupported command:$cmd" >&2
    exit 2
    ;;
esac
