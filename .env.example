# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fullstack_monorepo_dev

# API
DATABASE_URL=postgresql://postgres:password@localhost:5432/fullstack_monorepo_dev
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
API_PORT=8000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Web
AUTH_SECRET=<generate-with-npx-auth-secret>
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_MAX_RETRIES=3
NEXT_PUBLIC_API_RETRY_DELAY=1000
NEXT_PUBLIC_API_RETRY_BACKOFF=2

# NODE_ENV is intentionally not set here: next/nest set it per command
# (dev, build, start), and a shared value breaks `next build`.

# Local overrides:
# Copy this file to .env and fill in real values.
# For personal secrets/overrides, create .env.local (gitignored).
# In mise.local.toml, add: [env] _.file = ".env.local"
