DATABASE_URL=postgresql://postgres:password@localhost:5432/fullstack_monorepo_dev
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
API_PORT=8000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# NODE_ENV is intentionally not set here: nest sets it per command.
# Copy this file to .env (same directory) and fill in real values.
# NODE_ENV=test also loads .env.test, which takes precedence over .env.
