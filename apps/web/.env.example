AUTH_SECRET=<generate-with-pnpm-dlx-auth-secret>
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30000
API_MAX_RETRIES=3
API_RETRY_DELAY=1000
API_RETRY_BACKOFF=2

# NODE_ENV is intentionally not set here: next sets it per command
# (dev, build, start), and a shared value breaks `next build`.
# Copy this file to .env (same directory) and fill in real values.
# Personal overrides go in .env.local (gitignored, loaded by Next.js).
