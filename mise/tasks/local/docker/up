#!/usr/bin/env bash
#MISE description="Build & start all containers (postgres, api, web, mailpit)"
set -e
ROOT="$(git rev-parse --show-toplevel)"
# With Infisical configured, refresh apps/*/.env from 'local' and refuse to
# start on a file pulled from another environment. SKIP_ENV_PULL=1 skips the
# pull (offline) but still checks.
if [ -f "$ROOT/.infisical.json" ]; then
  if [ "${SKIP_ENV_PULL:-0}" != 1 ]; then
    "$ROOT/tools/env/pull" local
  fi
  # shellcheck source=tools/env/lib.sh
  (source "$ROOT/tools/env/lib.sh" && assert_stamps local)
fi
# Docker creates a missing mount point as root; create it as the host user.
mkdir -p apps/web/.next
HOST_UID="$(id -u)" HOST_GID="$(id -g)" \
  docker compose up --build --renew-anon-volumes --wait
